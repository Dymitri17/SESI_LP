
#include <stdio.h>

int main() {
    int matriz[2][2];
    int soma = 0;
    
    printf("Digite os elementos da matriz 2x2:\n");
    for(int i=0; i<2; i++){
        for(int j=0; j<2; j++){
            printf("Linha %i, Coluna %i: ", i+1, j+1);
            scanf("%i", &matriz[i][j]);
            soma += matriz[i][j];
        }
    }
    
    printf("\nSoma dos elementos: %i\n", soma);
}


