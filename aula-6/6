#include <stdio.h>

int main() {
    int matriz[4][4];
    int maior = 0, menor = 0;
    
    printf("Digite os elementos da matriz 4x4:\n");
    for(int i=0; i<4; i++){
        for(int j=0; j<4; j++){
            printf("Linha %i, Coluna %i: ", i+1, j+1);
            scanf("%i", &matriz[i][j]);
            if(i==0 && j==0){
                maior = menor = matriz[i][j];
            } else {
                if(matriz[i][j] > maior) maior = matriz[i][j];
                if(matriz[i][j] < menor) menor = matriz[i][j];
            }
        }
    }
    
    printf("\nMaior valor: %i\nMenor valor: %i\n", maior, menor);
}
