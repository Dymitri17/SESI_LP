#include <stdio.h>

int main() {
    int matriz[3][3];
    
    printf("Digite os elementos da matriz 3x3:\n");
    for(int i=0; i<3; i++){
        for(int j=0; j<3; j++){
            printf("Linha %i, Coluna %i: ", i+1, j+1);
            scanf("%i", &matriz[i][j]);
        }
    }
    
    printf("\nSoma de cada linha:\n");
    for(int i=0; i<3; i++){
        int soma = 0;
        for(int j=0; j<3; j++){
            soma += matriz[i][j];
        }
        printf("Linha %i: %i\n", i+1, soma);
    }
}
