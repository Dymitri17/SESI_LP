#include <stdio.h>

int main() {
    int matriz[4][4];
    int cont = 0;
    
    printf("Digite os elementos da matriz 4x4:\n");
    for(int i=0; i<4; i++){
        for(int j=0; j<4; j++){
            printf("Linha %i, Coluna %i: ", i+1, j+1);
            scanf("%i", &matriz[i][j]);
            if(matriz[i][j] > 10) cont++;
        }
    }
    
    printf("\nNumeros maiores que 10: %i\n", cont);
}
