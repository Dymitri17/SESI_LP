#include <stdio.h>

int main() {
    int matriz[3][3];
    
    printf("Digite os elementos da matriz 3x3:\n");
    for(int i=0; i<3; i++){
        for(int j=0; j<3; j++){
            printf("Linha %i, Coluna %i: ", i+1, j+1);
            scanf("%i", &matriz[i][j]);
        }
    }
    
    printf("\nDiagonal principal: ");
    for(int i=0; i<3; i++){
        printf("| %i", matriz[i][i]);
    }
    printf(" |\n");
}
